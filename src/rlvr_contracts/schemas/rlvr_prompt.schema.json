{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rlvr.local/schemas/rlvr_prompt.schema.json",
  "title": "RLVRPromptRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "problem_id",
    "family_id",
    "partition",
    "prompt",
    "answer_spec",
    "verifier_type",
    "verifier_version"
  ],
  "properties": {
    "problem_id": { "type": "string", "minLength": 1 },
    "family_id": { "type": "string", "minLength": 1 },
    "partition": {
      "type": "string",
      "enum": ["rlvr_train", "rlvr_eval", "contaminated_diagnostic"]
    },
    "domain": { "type": "string" },
    "prompt": { "type": "string", "minLength": 1 },
    "response": { "type": "string", "const": "" },
    "answer_spec": {
      "type": "object",
      "required": ["type", "canonical"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["integer", "rational", "decimal_exact", "decimal_approx", "logic_json"]
        },
        "canonical": { "type": ["string", "number", "object", "array"] },
        "tolerance": { "type": "number" },
        "verifier_artifact": { "type": "string" },
        "ground_truth_structured": {}
      },
      "additionalProperties": true
    },
    "verifier_type": { "type": "string" },
    "verifier_version": { "type": "string", "minLength": 1 },
    "empirical_difficulty": { "type": "object", "additionalProperties": true },
    "lineage": { "type": "object", "additionalProperties": true },
    "provenance": { "type": "object", "additionalProperties": true },
    "licensing": { "type": "object", "additionalProperties": true },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}
